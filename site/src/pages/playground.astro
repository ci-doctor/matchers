---
import Base from "../layouts/Base.astro";
import Seg from "../components/Seg.astro";
import { entries } from "../lib/registry.ts";
import type { PlaygroundData } from "../scripts/playground/data.ts";
import "../styles/log.css";
import "../styles/yaml.css";
import "../styles/playground.css";

// Everything the playground needs, embedded: pasted logs never leave the page.
const data: PlaygroundData = { matchers: {}, bundles: {} };
for (const e of entries) {
    if (e.kind === "matcher") {
        const fixtures = e.fixtures.map((f) => ({
            name: f.name,
            logs: f.logs,
        }));
        data.matchers[e.name] = {
            yaml: e.yaml,
            eco: e.eco,
            description: e.description,
            fixtures,
        };
    } else {
        data.bundles[e.name] = {
            description: e.description,
            members: e.members,
        };
    }
}
---

<Base
    title="Playground"
    description="Run a matcher, or your own draft, against a CI log in the browser."
    wide
    footer={false}
>
    <script type="application/json" id="data" set:html={JSON.stringify(data)} />
    <div class="pg">
        <section class="pane pane-rule">
            <header class="pane-h">
                <h2>Rule</h2>
                <div
                    class="combo"
                    id="pick"
                    data-label="Rule to load"
                    data-placeholder="Search bundles and matchers…"
                ></div>
            </header>
            <div class="editor">
                <pre class="hl" id="hl" aria-hidden="true"></pre>
                <textarea
                    id="rule"
                    rows="18"
                    spellcheck="false"
                    autocapitalize="off"
                    aria-label="Rule source"
                ></textarea>
            </div>
            <p class="hint">
                Several rules: separate YAML documents with <code>---</code>.
            </p>
            <div id="status"></div>
            <div class="results-wrap">
                <h2>Matches</h2>
                <ul class="results" id="results"></ul>
            </div>
        </section>

        <section class="pane pane-log">
            <header class="pane-h">
                <h2>Log</h2>
                <Seg
                    name="prov"
                    label="Provider"
                    options={[
                        {
                            value: "github",
                            label: "GitHub Actions",
                            checked: true,
                        },
                        { value: "gitlab", label: "GitLab CI" },
                    ]}
                />
                <div
                    class="combo"
                    id="fixture"
                    data-label="Load a fixture"
                    data-placeholder="Load a fixture… (search)"
                ></div>
            </header>
            <label class="dz" id="dz">
                <input
                    type="file"
                    class="sr"
                    id="file"
                    accept=".log,.txt,text/plain"
                />
                <svg
                    viewBox="0 0 24 24"
                    width="22"
                    height="22"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M12 16V4M7 9l5-5 5 5" />
                    <path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" />
                </svg>
                <span id="dzt">
                    Drop a .log file or <u>browse</u>
                </span>
            </label>
            <textarea
                id="log"
                rows="7"
                spellcheck="false"
                placeholder="…or paste a job log here. It stays in your browser."
                aria-label="Log"
            ></textarea>
            <div class="row view">
                <Seg
                    name="view"
                    label="View"
                    options={[
                        { value: "matches", label: "Matches", checked: true },
                        { value: "raw", label: "Raw" },
                    ]}
                />
                <span class="legend" id="stats"></span>
            </div>
            <div class="log" id="out" aria-live="polite"></div>
        </section>
    </div>
    <script>
        import "../scripts/playground/main.ts";
    </script>
</Base>
