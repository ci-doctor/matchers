---
import Base from '../layouts/Base.astro';
import { entries } from '../lib/registry.ts';

// Everything the playground needs, embedded: pasted logs never leave the page.
const data = {
  matchers: Object.fromEntries(entries.filter((e) => e.kind === 'matcher').map((e) => [e.name, { yaml: e.yaml, eco: e.eco, description: e.description, fixtures: e.fixtures.map((f) => ({ name: f.name, log: f.log })) }])),
  bundles: Object.fromEntries(entries.filter((e) => e.kind === 'bundle').map((e) => [e.name, e.members])),
  bundleDesc: Object.fromEntries(entries.filter((e) => e.kind === 'bundle').map((e) => [e.name, e.description])),
};
---

<Base title="Playground" description="Run a matcher, or your own draft, against a CI log in the browser." wide>
  <script type="application/json" id="data" set:html={JSON.stringify(data)} />
  <h1 class="pg-title">Playground</h1>
  <p class="lead pg-lead">Edit a rule on the left, give it a log on the right. Everything runs in your browser; logs never leave this page.</p>
  <div class="pg">
    <section class="pane pane-rule">
      <header class="pane-h">
        <h2>Rule</h2>
        <div class="combo" id="pick" data-label="Rule to load" data-placeholder="Search bundles and matchers…"></div>
      </header>
      <div class="editor">
        <pre class="hl" id="hl" aria-hidden="true"></pre>
        <textarea id="rule" rows="18" spellcheck="false" autocapitalize="off" aria-label="Rule source"></textarea>
      </div>
      <p class="hint">Several rules: separate YAML documents with <code>---</code>.</p>
      <div id="status"></div>
      <div class="results-wrap">
        <h2>Matches</h2>
        <ul class="results" id="results"></ul>
      </div>
    </section>

    <section class="pane pane-log">
      <header class="pane-h">
        <h2>Log</h2>
        <div class="combo" id="fixture" data-label="Load a fixture" data-placeholder="Load a fixture… (search)"></div>
      </header>
      <div class="row">
        <span class="seg" role="radiogroup" aria-label="Provider">
          <label><input type="radio" name="prov" value="github" checked /><span>GitHub Actions</span></label>
          <label><input type="radio" name="prov" value="gitlab" /><span>GitLab CI</span></label>
        </span>
      </div>
      <label class="dz" id="dz">
        <input type="file" class="sr" id="file" accept=".log,.txt,text/plain" />
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
        <span id="dzt">Drop a .log file or <u>browse</u></span>
      </label>
      <textarea id="log" class="plain" rows="7" spellcheck="false" placeholder="…or paste a job log here." aria-label="Log"></textarea>
      <div id="notice" class="notice"></div>
      <div class="row">
        <span class="seg" role="radiogroup" aria-label="View">
          <label><input type="radio" name="view" value="matches" checked /><span>Matches</span></label>
          <label><input type="radio" name="view" value="raw" /><span>Raw</span></label>
        </span>
        <span class="legend" id="stats"></span>
      </div>
      <div class="log" id="out" aria-live="polite"></div>
    </section>
  </div>
  <script>
    import '../scripts/playground.ts';
  </script>
</Base>
