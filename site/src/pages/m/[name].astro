---
import Base from '../../layouts/Base.astro';
import { entries, byName, GITHUB, FRAMING_NAME } from '../../lib/registry.ts';
import { highlight } from '../../lib/yaml-highlight.ts';
import '../../styles/log.css';
import '../../styles/yaml.css';

export const getStaticPaths = () => entries.map((e) => ({ params: { name: e.name } }));
const e = byName(Astro.params.name!);
const lines = (text: string) => text.replace(/\n$/, '').split('\n');
---

<Base title={e.name} description={e.description}>
  <p class="legend"><a href="/">← Catalogue</a></p>
  <h1>{e.name}</h1>
  <p class="lead">{e.description}</p>
  <p>
    <span class="chip eco">{e.eco}</span>
    {e.tags.map((t) => <span class="chip">{t}</span>)}
    <span class="chip">{e.kind}</span>
  </p>
  <div class="btn-row">
    <a class="btn" href={`${GITHUB}/blob/main/${e.path}`}>File on GitHub</a>
    <a class="btn" href={`${GITHUB}/commits/main/${e.path}`}>History</a>
  </div>
  <p>Install: <code>ci-doctor matchers add official/{e.name}</code></p>
  {e.kind === 'matcher' && <p>Try it on your log: <code>ci-doctor matchers try official/{e.name} job.log</code></p>}

  {e.outputs.length > 0 && (
    <>
      <h2>Outputs</h2>
      <table>
        <thead><tr><th>Output</th><th>Role</th><th>What it means</th></tr></thead>
        <tbody>
          {e.outputs.map((o) => (
            <tr>
              <td><code>{o.id}</code>{o.variants.length > 0 && <span class="legend"> ({o.variants.join(', ')})</span>}</td>
              <td>{o.role}</td>
              <td>{o.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  <h2>{e.path}</h2>
  <pre class="src hl" set:html={highlight(e.yaml.trimEnd())} />

  {e.kind === 'bundle' && (
    <>
      <h2>Contains</h2>
      <p>{e.members.length} matchers, bundles flattened:</p>
      <ul class="tight">
        {e.members.map((m) => <li><a href={`/m/${m}/`}>{m}</a> <span class="legend">{byName(m).description}</span></li>)}
      </ul>
    </>
  )}

  {e.containedIn.length > 0 && (
    <>
      <h2>In bundles</h2>
      <p>{e.containedIn.map((b) => <a class="chip" href={`/m/${b}/`}>{b}</a>)}</p>
    </>
  )}

  {e.kind === 'matcher' && (
    <>
      <h2>Fixtures</h2>
      <p class="legend">What each output selects from each log: the committed <code>.expected</code>, ci-doctor's own output.</p>
      {e.fixtures.map((f) => (
        <section class="fixture">
          <h3><code>{f.name}</code> <span class="chip">{FRAMING_NAME[f.framing]}</span></h3>
          {e.outputs.map((o) => (
            <>
              {e.outputs.length > 1 && <h4><code>{o.id}</code></h4>}
              {f.expected[o.id]
                ? <div class="log">{lines(f.expected[o.id]).map((l, i) => <div class="ln"><i>{i + 1}</i>{l}</div>)}</div>
                : <p><span class="chip warn">must not fire</span></p>}
            </>
          ))}
          <details>
            <summary>The raw log</summary>
            <div class="log">{lines(f.log).map((l, i) => <div class="ln"><i>{i + 1}</i>{l}</div>)}</div>
          </details>
        </section>
      ))}
    </>
  )}
</Base>

<style>
  .fixture h3 { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  .fixture details { margin: 0.6rem 0 1.5rem; }
  pre.src {
    background: var(--card); color: var(--fg); border: 1px solid var(--border-strong); border-radius: var(--radius-sm);
    padding: 0.85rem; overflow-x: auto; font: 0.82rem/1.55 var(--mono); tab-size: 2;
  }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { text-align: left; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--border); vertical-align: top; }
</style>
