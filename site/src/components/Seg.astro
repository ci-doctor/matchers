---
// A segmented control: a radio group styled as joined buttons.
interface Option {
  value: string;
  label: string;
  checked?: boolean;
  disabled?: boolean;
  /** Tooltip, e.g. why the option is disabled. */
  title?: string;
}
interface Props {
  name: string;
  label: string;
  options: Option[];
}
const { name, label, options } = Astro.props;
---

<span class="seg" role="radiogroup" aria-label={label}>
  {options.map((o) => (
    <label title={o.title}>
      <input type="radio" name={name} value={o.value} checked={o.checked} disabled={o.disabled} aria-disabled={o.disabled ? 'true' : undefined} />
      <span>{o.label}</span>
    </label>
  ))}
</span>
